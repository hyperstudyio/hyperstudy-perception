{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hyperstudy.io/schemas/perception-bundle/0.1/bundle.schema.json",
  "title": "HyperStudy perception track bundle, v0.1",
  "description": "Root: manifest.json. Layer files validate against #/$defs/layer/<name>. Conventions in schema/README.md.",
  "type": "object",
  "required": ["format", "schema_version", "created_at", "video", "pipeline", "layers"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "hyperstudy-perception-bundle" },
    "schema_version": { "$ref": "#/$defs/semver" },
    "created_at": { "type": "string", "format": "date-time" },
    "video": {
      "type": "object",
      "required": ["sha256", "duration", "fps", "width", "height"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "filename": { "type": "string", "description": "Name of the source file when the bundle was made; a hint only." }
      }
    },
    "pipeline": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "git_commit": { "type": ["string", "null"] },
        "source": { "type": "string", "description": "How the bundle was made, e.g. 'pipeline run' or 'converted from bake-off run'." }
      }
    },
    "layers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/layerName" },
      "additionalProperties": {
        "type": "object",
        "required": ["file", "sha256", "bytes", "licence_mode", "stage"],
        "properties": {
          "file": { "type": "string", "pattern": "^layers/[a-z_]+\\.json$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "licence_mode": { "$ref": "#/$defs/licenceMode" },
          "stage": { "type": "string" },
          "side_files": {
            "type": "array",
            "items": {
              "type": "object", "required": ["file", "sha256", "bytes"],
              "properties": { "file": { "type": "string" }, "sha256": { "type": "string" }, "bytes": { "type": "integer" } }
            }
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "description": "Small images under assets/ (person, face-track and object crops), referenced by relative path from layers.",
      "items": {
        "type": "object", "required": ["file", "sha256", "bytes"],
        "properties": {
          "file": { "type": "string", "pattern": "^assets/[A-Za-z0-9_./-]+$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },

  "$defs": {
    "semver": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "layerName": { "enum": ["shots", "transcript", "speakers", "faces", "bodies", "hands", "gestures", "facing", "gaze", "objects", "sounds", "text", "prosody", "waveform"] },
    "licenceMode": { "enum": ["academic-only", "commercial-ok", "needs-review", "api-terms"] },
    "time": { "type": "number", "minimum": 0 },
    "box": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[x, y, w, h] in source pixels" },
    "point": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "keypoints": { "type": "array", "items": { "type": "array", "items": { "type": ["number", "null"] }, "minItems": 3, "maxItems": 3 }, "description": "[[x, y, score], ...]" },
    "span": {
      "type": "object", "required": ["start", "end"],
      "properties": { "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" } }
    },
    "id": {
      "shot": { "type": "string", "pattern": "^shot:\\d+$" },
      "utt": { "type": "string", "pattern": "^utt:\\d+$" },
      "voice": { "type": "string", "pattern": "^voice:.+$" },
      "face": { "type": "string", "pattern": "^face:\\d+$" },
      "person": { "type": "string", "pattern": "^person:.+$" },
      "body": { "type": "string", "pattern": "^body:\\d+$" },
      "hand": { "type": "string", "pattern": "^hand:\\d+$" },
      "obj": { "type": "string", "pattern": "^obj:\\d+$" },
      "objid": { "type": "string", "pattern": "^objid:.+$" },
      "event": { "type": "string", "pattern": "^(sound|text|gesture|facing|gaze):\\d+$" }
    },
    "model": {
      "type": "object", "required": ["id", "licence_mode"],
      "properties": {
        "id": { "type": "string", "description": "Model name, e.g. 'facebook/sam3' or 'LR-ASD TalkSet finetune'." },
        "source": { "type": ["string", "null"], "description": "hf://repo@revision[/file] or a URL." },
        "revision": { "type": ["string", "null"] },
        "licence": { "type": ["string", "null"] },
        "licence_mode": { "$ref": "#/$defs/licenceMode" }
      }
    },
    "producer": {
      "type": "object", "required": ["stage", "stage_version", "models"],
      "properties": {
        "stage": { "type": "string" },
        "stage_version": { "type": "string" },
        "models": { "type": "array", "items": { "$ref": "#/$defs/model" } },
        "config": { "type": "object" },
        "device": { "type": ["string", "null"] },
        "run_at": { "type": ["string", "null"] },
        "timings": { "type": "object" }
      }
    },
    "side": {
      "faces_detail": {
        "description": "layers/faces_detail.json, the faces layer's side file (its detail.file): py-feat's output per face track sample, keyed by the layer's track ids, one entry per sample of that track in order.",
        "type": "object",
        "required": ["au_names", "emotion_names", "tracks"],
        "properties": {
          "au_names": { "type": "array", "items": { "type": "string" }, "description": "The order of each sample's au." },
          "emotion_names": { "type": "array", "items": { "type": "string" }, "description": "The order of each sample's emo." },
          "angles": { "type": "string", "description": "Units and sign convention of head pose and gaze." },
          "tracks": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/id/face" },
            "additionalProperties": { "type": "array", "items": {
              "type": "object", "required": ["t", "lmk", "au", "emo", "va", "head", "gaze"],
              "properties": {
                "t": { "$ref": "#/$defs/time" },
                "lmk": { "type": "array", "items": { "type": "number" }, "minItems": 136, "maxItems": 136, "description": "68 landmarks: all x, then all y, in source pixels." },
                "au": { "type": "array", "items": { "type": "number" } },
                "emo": { "type": "array", "items": { "type": "number" } },
                "va": { "$ref": "#/$defs/point", "description": "[valence, arousal]" },
                "head": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3, "description": "[yaw, pitch, roll]" },
                "gaze": { "$ref": "#/$defs/point", "description": "[yaw, pitch]" }
              } } }
          }
        }
      },
      "faces_mesh": {
        "description": "layers/faces_mesh.json, the faces layer's mesh side file (its mesh.file): py-feat's 478-point 2D face mesh per face track sample, keyed by the layer's track ids, one entry per sample of that track in order. Large; readers fetch it only when they draw the mesh.",
        "type": "object",
        "required": ["points", "tracks"],
        "properties": {
          "points": { "const": 478, "description": "Mesh points per sample." },
          "layout": { "type": "string", "description": "The order of each sample's xy." },
          "tracks": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/id/face" },
            "additionalProperties": { "type": "array", "items": {
              "type": "object", "required": ["t", "xy"],
              "properties": {
                "t": { "$ref": "#/$defs/time" },
                "xy": { "type": "array", "items": { "type": "integer" }, "minItems": 956, "maxItems": 956, "description": "478 points: all x, then all y, in source pixels, rounded to integers." }
              } } }
          }
        }
      },
      "faces_embeddings": {
        "description": "layers/faces_embeddings.json, the faces layer's embeddings side file (its embeddings.file): the 512-d ArcFace identity embedding (InsightFace w600k_r50 weights, via py-feat Detectorv2) per face track sample, keyed by the layer's track ids, one entry per sample of that track in order; the vectors the layer's people and person_pairs were computed from. Identity data, and research-only (academic-only) weights, as for the faces layer.",
        "type": "object",
        "required": ["model", "dims", "normalised", "tracks"],
        "properties": {
          "model": { "type": "string", "description": "The embedding model." },
          "dims": { "const": 512, "description": "Values per embedding." },
          "normalised": { "type": "boolean", "description": "Whether each v is L2-normalised. py-feat's ArcFace output is not (false): normalise before taking cosine distances." },
          "tracks": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/id/face" },
            "additionalProperties": { "type": "array", "items": {
              "type": "object", "required": ["t", "v"],
              "properties": {
                "t": { "$ref": "#/$defs/time" },
                "v": { "type": "array", "items": { "type": "number" }, "minItems": 512, "maxItems": 512, "description": "The embedding, rounded to 4 decimal places." }
              } } }
          }
        }
      },
      "transcript_diarization": {
        "description": "layers/transcript_diarization.json, the transcript layer's raw side file (raw.diarization): what the speaker diarization pipeline (pyannote speaker-diarization-community-1) returned, of which the layer keeps each word's and utterance's voice. Its turns are what the voices were assigned from: a word takes the voice whose turns overlap it longest (summed over that voice's turns; a tie goes to the earlier turn), an utterance its words' most common voice. Times are unrounded (pyannote's frame grid: a turn covers the frames whose middle is in [start, end)), so the turns give exactly the layer's voices.",
        "type": "object",
        "required": ["model", "voices", "turns", "exclusive_turns"],
        "properties": {
          "model": { "type": "string", "description": "The diarization pipeline." },
          "voices": { "type": "array", "items": { "$ref": "#/$defs/id/voice" }, "uniqueItems": true, "description": "Every speaker the pipeline found, as voice ids (voice:<its label>), in its order (the order of its speaker embeddings); a voice no word was assigned to is here but not in the layer's voices." },
          "turns": { "type": "array", "items": { "$ref": "#/$defs/side/transcript_diarization/$defs/turn" }, "description": "Speaker turns in the pipeline's order (by start); turns of two voices overlap where both speak." },
          "exclusive_turns": { "type": "array", "items": { "$ref": "#/$defs/side/transcript_diarization/$defs/turn" }, "description": "The pipeline's exclusive diarization: turns of at most one voice at a time (where turns overlap, one voice's), its version for aligning a transcript. The layer does not use them." }
        },
        "$defs": {
          "turn": { "type": "object", "required": ["start", "end", "voice"], "properties": {
            "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
            "voice": { "$ref": "#/$defs/id/voice", "description": "One of voices." } } }
        }
      },
      "transcript_voice_embeddings": {
        "description": "layers/transcript_voice_embeddings.json, the transcript layer's raw side file (raw.voice_embeddings): the diarization pipeline's speaker embedding per voice, the centroid (VBx responsibilities as weights) of the 256-d WeSpeaker ResNet34 embeddings of that voice's clustered speech, keyed by the voice ids of transcript_diarization's voices, in their order. Identity data (a voiceprint).",
        "type": "object",
        "required": ["model", "dims", "normalised", "voices"],
        "properties": {
          "model": { "type": "string", "description": "The embedding model." },
          "dims": { "const": 256, "description": "Values per embedding." },
          "normalised": { "type": "boolean", "description": "Whether each embedding is L2-normalised. pyannote's centroids are not (false): normalise before taking cosine distances." },
          "voices": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/id/voice" },
            "additionalProperties": { "oneOf": [
              { "type": "array", "items": { "type": "number" }, "minItems": 256, "maxItems": 256, "description": "The embedding, rounded to 4 decimal places." },
              { "type": "null", "description": "A voice the pipeline has no centroid for (it pads that row with zeros)." }] }
          }
        }
      }
    },
    "parquet": {
      "gaze_heatmaps": {
        "description": "layers/gaze_heatmaps.parquet, the gaze layer's raw side file (raw.heatmaps): Gaze-LLE's whole output for every head, of which the layer keeps the peak, the in-frame score and the target. One row per sample of the gaze layer's tracks, in time order (the heads of one frame in the layer's track order). Each heatmap is quantised relative to its own maximum: cell = floor(255 * heat / max), so heat is in [cell, cell + 1) / 255 * max and (cell + 0.5) / 255 * max is within max / 510 of it; only the maximum is 255, so the stored map's argmax is the cell of the layer's peak. Columns are not nullable.",
        "per_sample": true,
        "columns": [
          { "name": "face", "arrow": "string", "description": "The face track (face:N): the gaze layer's tracks[].face." },
          { "name": "sample", "arrow": "int32", "description": "The sample's index in that track's samples." },
          { "name": "t", "arrow": "double", "description": "The sample's time, as the layer's." },
          { "name": "inout", "arrow": "float", "description": "Gaze-LLE's in-frame score in [0, 1], unrounded (the layer's in_frame is it to 3 places)." },
          { "name": "max", "arrow": "float", "description": "The heatmap's largest value, the scale of heat: a sigmoid's, in [0, 1] in float32 (0 only for a map that is all zeros, whose cells are all 0)." },
          { "name": "heat", "arrow": "fixed_size_binary[4096]", "description": "The 64x64 heatmap over the whole frame as uint8, row-major: byte 64 * row + col is the cell whose centre is ((col + 0.5) / 64 * width, (row + 0.5) / 64 * height) in source pixels." }
        ]
      },
      "shots_scores": {
        "description": "layers/shots_scores.parquet, the shots layer's raw side file (raw.scores): what PySceneDetect's AdaptiveDetector computed for every frame, of which the layer keeps only the cuts. One row per frame the detector scored, in order. A cut is a frame, not among the first or last window_width, with adaptive_ratio >= adaptive_threshold and content_val >= min_content_val, at least min_scene_len frames after the previous cut (or the first frame), counting frames as round(seconds between their t * frame_rate); the layer's shots start at the cuts (t to 3 places). The detector's parameters are the file's metadata under the key detector, as JSON: adaptive_threshold, min_content_val, min_scene_len (frames), window_width, weights (of the deltas in content_val), luma_only, kernel_size (of the edge dilation), frame_size (the downscaled frame it scored, [width, height]) and frame_rate. What the detector does not compute is 0: the first frame's content_val and deltas (it has no frame before it, and the detector scores it 0) and the adaptive_ratio of the first and last window_width frames (no full window around them; none can be a cut). Columns are not nullable.",
        "columns": [
          { "name": "frame", "arrow": "int32", "description": "The frame's index among those the detector scored, from 0." },
          { "name": "t", "arrow": "double", "description": "The frame's time in seconds, as PySceneDetect places it (its OpenCV position, to the microsecond)." },
          { "name": "content_val", "arrow": "double", "description": "The frame's score: the weighted mean of the deltas (weights in the metadata; by default hue, saturation and luma equally, edges not at all)." },
          { "name": "delta_hue", "arrow": "double", "description": "Mean absolute difference of the HSV hue channel from the frame before, in 8-bit levels." },
          { "name": "delta_sat", "arrow": "double", "description": "Mean absolute difference of the HSV saturation channel from the frame before, in 8-bit levels." },
          { "name": "delta_lum", "arrow": "double", "description": "Mean absolute difference of the HSV value (luma) channel from the frame before, in 8-bit levels." },
          { "name": "delta_edges", "arrow": "double", "description": "Mean absolute difference of the dilated Canny edge maps (0 or 255 a pixel) from the frame before." },
          { "name": "adaptive_ratio", "arrow": "double", "description": "content_val over the mean content_val of the window_width frames on each side, capped at 255 (255 when that mean is 0 and content_val >= min_content_val, 0 when the mean is 0 and it is not)." }
        ]
      },
      "transcript_tokens": {
        "description": "layers/transcript_tokens.parquet, the transcript layer's raw side file (raw.tokens): every subword token Parakeet TDT returned (parakeet-mlx 0.5.3, greedy decoding), of which the layer keeps only the words they merge into and those words' times. One row per token, in time order. A token whose text starts with a space starts a word; the others extend it, never across a sentence. Greedy decoding has no alternative hypotheses. Columns are not nullable. Per word: the word column indexes the transcript layer's words in order, each word with a token, its start the first token's and its end the last token's (validate.py checks this).",
        "per_word": true,
        "columns": [
          { "name": "id", "arrow": "int32", "description": "The token's id in Parakeet's 8192-token SentencePiece vocabulary." },
          { "name": "text", "arrow": "string", "description": "The token's text, a leading space for SentencePiece's word boundary." },
          { "name": "start", "arrow": "double", "description": "When the token was emitted, in seconds to 3 places: its encoder frame times 0.08 s." },
          { "name": "end", "arrow": "double", "description": "start plus the token's duration as TDT predicts it (0 to 4 frames of 0.08 s), in seconds to 3 places. A word's start and end in the layer are its first token's start and its last token's end." },
          { "name": "confidence", "arrow": "float", "description": "parakeet-mlx's confidence in [0, 1], as computed: 1 - H / ln(8193), H the entropy of the softmax over the vocabulary and the blank at the step that emitted the token. A sentence's confidence is the geometric mean of its tokens'." },
          { "name": "sentence", "arrow": "int32", "description": "Parakeet's sentence: it splits the tokens at . ? and ! (counting from 0)." },
          { "name": "word", "arrow": "int32", "description": "The index in the layer's words of the word the token is part of, or -1 for a token in no word (a word that would be only spaces)." }
        ]
      }
    },
    "sidePointer": {
      "type": "object", "required": ["file", "format", "description"],
      "description": "Where one of a layer's side files is, in what format, and what it holds.",
      "properties": {
        "file": { "type": "string", "pattern": "^layers/[a-z][a-z0-9_]*\\.(json|parquet)$", "description": "layers/<name>.<format>: a side file the manifest lists under this layer's side_files." },
        "format": { "enum": ["json", "parquet"], "description": "json: validates against #/$defs/side/<name>. parquet: Apache Parquet, columns as #/$defs/parquet/<name>." },
        "description": { "type": "string", "minLength": 1, "description": "One line: what the file holds." }
      }
    },
    "layerBase": {
      "type": "object", "required": ["layer", "schema_version", "producer"],
      "properties": {
        "layer": { "$ref": "#/$defs/layerName" },
        "schema_version": { "$ref": "#/$defs/semver" },
        "producer": { "$ref": "#/$defs/producer" },
        "raw": {
          "type": "object",
          "description": "The layer's raw side files: what its model returned beyond what the layer draws, by role (e.g. heatmaps). Optional; the faces layer's detail, mesh and embeddings point at its side files the older way.",
          "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
          "additionalProperties": { "$ref": "#/$defs/sidePointer" }
        }
      }
    },

    "layer": {
      "shots": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "shots" } } }],
        "required": ["shots"],
        "properties": {
          "shots": { "type": "array", "items": {
            "type": "object", "required": ["id", "index", "start", "end"],
            "properties": {
              "id": { "$ref": "#/$defs/id/shot" }, "index": { "type": "integer", "minimum": 0 },
              "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
              "keyframes": { "type": "array", "items": { "type": "object", "required": ["t"], "properties": { "t": { "$ref": "#/$defs/time" }, "file": { "type": ["string", "null"] } } } },
              "caption": { "type": ["object", "null"], "properties": {
                "description": { "type": ["string", "null"] }, "setting": { "type": ["string", "null"] }, "mood": { "type": ["string", "null"] },
                "people": { "type": "array" }, "model": { "type": "string" } } }
            } } }
        }
      },

      "transcript": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "transcript" } } }],
        "required": ["words", "utterances", "voices"],
        "properties": {
          "voices": { "type": "array", "items": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "#/$defs/id/voice" } } } },
          "words": { "type": "array", "items": {
            "type": "object", "required": ["w", "start", "end"],
            "properties": { "w": { "type": "string" }, "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
              "voice": { "oneOf": [{ "$ref": "#/$defs/id/voice" }, { "type": "null" }] } } } },
          "utterances": { "type": "array", "items": {
            "type": "object", "required": ["id", "start", "end", "text", "shot", "words"],
            "properties": { "id": { "$ref": "#/$defs/id/utt" }, "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
              "text": { "type": "string" }, "shot": { "$ref": "#/$defs/id/shot" },
              "words": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2, "description": "[first, last] word index, inclusive" },
              "voice": { "oneOf": [{ "$ref": "#/$defs/id/voice" }, { "type": "null" }] } } } }
        }
      },

      "speakers": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "speakers" } } }],
        "required": ["utterances"],
        "properties": {
          "utterances": { "type": "array", "items": {
            "type": "object", "required": ["utt", "predicted", "candidates"],
            "properties": {
              "utt": { "$ref": "#/$defs/id/utt" },
              "predicted": { "type": "object", "required": ["kind"], "properties": {
                "kind": { "enum": ["face", "person", "offscreen"], "description": "face: a visible face track; person: a known identity not visible (trusted voice link); offscreen: an unidentified voice" },
                "face": { "$ref": "#/$defs/id/face" }, "person": { "$ref": "#/$defs/id/person" },
                "voice": { "oneOf": [{ "$ref": "#/$defs/id/voice" }, { "type": "null" }] },
                "via": { "enum": ["asd", "voice_link", "none"] } } },
              "candidates": { "type": "array", "items": { "type": "object", "required": ["face", "score"],
                "properties": { "face": { "$ref": "#/$defs/id/face" }, "score": { "type": "number" } } } },
              "margin": { "type": ["number", "null"] },
              "second_opinion_agrees": { "type": ["boolean", "null"] }
            } } },
          "voice_links": { "type": "array", "items": { "type": "object", "required": ["voice", "person", "word_share"],
            "properties": { "voice": { "$ref": "#/$defs/id/voice" }, "person": { "$ref": "#/$defs/id/person" },
              "word_share": { "type": "number" }, "trusted": { "type": "boolean" } } } }
        }
      },

      "faces": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "faces" } } }],
        "required": ["sample_fps", "people", "tracks"],
        "properties": {
          "sample_fps": { "type": "number" },
          "angles": { "type": "string", "description": "Units and sign convention of head pose and gaze." },
          "people": { "type": "array", "items": { "type": "object", "required": ["id"],
            "properties": { "id": { "$ref": "#/$defs/id/person" }, "first_seen": { "type": ["number", "null"] },
              "seconds_on_screen": { "type": ["number", "null"] }, "crop": { "type": ["string", "null"] } } } },
          "tracks": { "type": "array", "items": {
            "type": "object", "required": ["id", "person", "shot", "start", "end", "samples"],
            "properties": {
              "id": { "$ref": "#/$defs/id/face" }, "shot": { "$ref": "#/$defs/id/shot" },
              "person": { "oneOf": [{ "$ref": "#/$defs/id/person" }, { "type": "null" }], "description": "null: not assigned to any identity cluster (the clusterer's Unknown)" },
              "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
              "linked_body": { "type": ["boolean", "null"], "description": "Ever linked to a posed body; false is a strong false-face hint." },
              "crop": { "type": ["string", "null"], "description": "assets/ path of a padded crop from the track's largest detection." },
              "samples": { "type": "array", "items": { "type": "object", "required": ["t", "box"],
                "properties": { "t": { "$ref": "#/$defs/time" }, "box": { "$ref": "#/$defs/box" },
                  "mouth": { "type": ["number", "null"] }, "gaze": { "oneOf": [{ "$ref": "#/$defs/point" }, { "type": "null" }] } } } }
            } } },
          "person_pairs": { "type": "array", "items": { "type": "object", "required": ["a", "b", "distance"],
            "properties": { "a": { "$ref": "#/$defs/id/person" }, "b": { "$ref": "#/$defs/id/person" },
              "distance": { "type": "number" }, "co_visible": { "type": "boolean" } } } },
          "detail": { "type": ["object", "null"], "required": ["file"], "properties": {
            "file": { "type": "string" }, "fields": { "type": "array", "items": { "type": "string" } } } },
          "mesh": { "type": ["object", "null"], "required": ["file"], "description": "Where the faces_mesh side file is.",
            "properties": { "file": { "type": "string" } } },
          "embeddings": { "type": ["object", "null"], "required": ["file"], "description": "Where the faces_embeddings side file is.",
            "properties": { "file": { "type": "string" } } }
        }
      },

      "bodies": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "bodies" } } }],
        "required": ["keypoint_names", "score_threshold", "fps", "tracks"],
        "properties": {
          "keypoint_names": { "type": "array", "items": { "type": "string" } },
          "skeleton": { "type": "array", "items": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 } },
          "score_threshold": { "type": "number" }, "fps": { "type": "number" },
          "tracks": { "type": "array", "items": { "type": "object", "required": ["id", "shot", "start", "end", "samples"],
            "properties": { "id": { "$ref": "#/$defs/id/body" }, "shot": { "$ref": "#/$defs/id/shot" },
              "face": { "oneOf": [{ "$ref": "#/$defs/id/face" }, { "type": "null" }] },
              "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
              "samples": { "type": "array", "items": { "type": "object", "required": ["t", "box", "kpts"],
                "properties": { "t": { "$ref": "#/$defs/time" }, "box": { "$ref": "#/$defs/box" }, "kpts": { "$ref": "#/$defs/keypoints" } } } } } } }
        }
      },

      "hands": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "hands" } } }],
        "required": ["keypoint_names", "fps", "hands"],
        "properties": {
          "keypoint_names": { "type": "array", "items": { "type": "string" } },
          "skeleton": { "type": "array" }, "score_threshold": { "type": ["number", "null"] }, "fps": { "type": "number" },
          "hands": { "type": "array", "items": { "type": "object", "required": ["id", "shot", "side", "start", "end", "samples"],
            "properties": { "id": { "$ref": "#/$defs/id/hand" }, "shot": { "$ref": "#/$defs/id/shot" },
              "side": { "enum": ["left", "right", null] },
              "body": { "oneOf": [{ "$ref": "#/$defs/id/body" }, { "type": "null" }] },
              "face": { "oneOf": [{ "$ref": "#/$defs/id/face" }, { "type": "null" }] },
              "box_source": { "type": "string" },
              "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
              "samples": { "type": "array", "items": { "type": "object", "required": ["t", "box", "kpts"],
                "properties": { "t": { "$ref": "#/$defs/time" }, "box": { "$ref": "#/$defs/box" }, "kpts": { "$ref": "#/$defs/keypoints" } } } } } } }
        }
      },

      "gestures": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "gestures" } } }],
        "required": ["events"],
        "properties": { "events": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "start", "end"],
          "properties": { "id": { "$ref": "#/$defs/id/event" }, "kind": { "type": "string" },
            "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
            "face": { "oneOf": [{ "$ref": "#/$defs/id/face" }, { "type": "null" }] },
            "hand": { "oneOf": [{ "$ref": "#/$defs/id/hand" }, { "type": "null" }] },
            "score": { "type": ["number", "null"] }, "detail": { "type": "object" } } } } }
      },

      "facing": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "facing" } } }],
        "required": ["events"],
        "properties": { "events": { "type": "array", "items": { "type": "object", "required": ["id", "from", "to", "start", "end"],
          "properties": { "id": { "$ref": "#/$defs/id/event" }, "from": { "$ref": "#/$defs/id/face" }, "to": { "$ref": "#/$defs/id/face" },
            "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
            "mutual": { "type": "boolean" }, "score": { "type": ["number", "null"] }, "detail": { "type": "object" } } } } }
      },

      "gaze": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "gaze" } } }],
        "required": ["fps", "tracks", "events"],
        "properties": {
          "fps": { "type": "number" },
          "tracks": { "type": "array", "items": { "type": "object", "required": ["face", "samples"],
            "properties": { "face": { "$ref": "#/$defs/id/face" },
              "samples": { "type": "array", "items": { "type": "object", "required": ["t"],
                "properties": { "t": { "$ref": "#/$defs/time" },
                  "peak": { "oneOf": [{ "$ref": "#/$defs/point" }, { "type": "null" }] },
                  "in_frame": { "type": ["number", "null"] },
                  "target": { "oneOf": [{ "$ref": "#/$defs/id/face" }, { "$ref": "#/$defs/id/obj" }, { "enum": ["out", "camera", null] }] },
                  "target_score": { "type": ["number", "null"] } } } } } } },
          "events": { "type": "array", "items": { "type": "object", "required": ["id", "kind", "from", "start", "end"],
            "properties": { "id": { "$ref": "#/$defs/id/event" }, "kind": { "enum": ["looks_at", "mutual_gaze", "joint_attention"] },
              "from": { "$ref": "#/$defs/id/face" },
              "to": { "oneOf": [{ "$ref": "#/$defs/id/face" }, { "type": "null" }] },
              "object": { "oneOf": [{ "$ref": "#/$defs/id/obj" }, { "type": "null" }] },
              "also": { "oneOf": [{ "$ref": "#/$defs/id/face" }, { "type": "null" }] },
              "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" }, "score": { "type": ["number", "null"] } } } }
        }
      },

      "objects": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "objects" } } }],
        "required": ["fps", "tracks", "identities"],
        "properties": {
          "fps": { "type": "number" },
          "tracks": { "type": "array", "items": { "type": "object", "required": ["id", "label", "identity", "shot", "start", "end", "samples"],
            "properties": { "id": { "$ref": "#/$defs/id/obj" }, "label": { "type": "string" }, "identity": { "$ref": "#/$defs/id/objid" },
              "shot": { "$ref": "#/$defs/id/shot" }, "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
              "wearer": { "oneOf": [{ "$ref": "#/$defs/id/person" }, { "type": "null" }] },
              "verdict": { "enum": ["object", "graphic", "absent", null] },
              "samples": { "type": "array", "items": { "type": "object", "required": ["t", "box"],
                "properties": { "t": { "$ref": "#/$defs/time" }, "box": { "$ref": "#/$defs/box" },
                  "poly": { "type": "array", "items": { "$ref": "#/$defs/point" } }, "score": { "type": ["number", "null"] } } } } } } },
          "identities": { "type": "array", "items": { "type": "object", "required": ["id", "label", "tracks"],
            "properties": { "id": { "$ref": "#/$defs/id/objid" }, "label": { "type": "string" }, "family": { "type": ["string", "null"] },
              "worn_by": { "type": "array", "items": { "$ref": "#/$defs/id/person" } },
              "tracks": { "type": "array", "items": { "$ref": "#/$defs/id/obj" } }, "crop": { "type": ["string", "null"] } } } },
          "rejected_tracks": { "type": "array", "items": { "type": "object", "required": ["id", "label", "verdict", "start", "end"],
            "properties": { "id": { "$ref": "#/$defs/id/obj" }, "verdict": { "enum": ["graphic", "absent"] } } } }
        }
      },

      "sounds": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "sounds" } } }],
        "required": ["events"],
        "properties": { "events": { "type": "array", "items": { "type": "object", "required": ["id", "label", "start", "end", "sources"],
          "properties": { "id": { "$ref": "#/$defs/id/event" }, "label": { "type": "string" },
            "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
            "sources": { "type": "array", "items": { "type": "string" } },
            "agreement": { "type": ["boolean", "null"], "description": "For query-model events: did a tagger agree? null for tagger events." },
            "score": { "type": ["number", "null"] } } } } }
      },

      "text": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "text" } } }],
        "required": ["items"],
        "properties": { "items": { "type": "array", "items": { "type": "object", "required": ["id", "text", "start", "end"],
          "properties": { "id": { "$ref": "#/$defs/id/event" }, "text": { "type": "string" },
            "start": { "$ref": "#/$defs/time" }, "end": { "$ref": "#/$defs/time" },
            "box": { "oneOf": [{ "$ref": "#/$defs/box" }, { "type": "null" }] } } } } }
      },

      "prosody": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "prosody" } } }],
        "required": ["contour", "utterances"],
        "properties": {
          "contour": { "type": "object", "required": ["step", "t0", "speakers", "f0_st", "speaker"],
            "properties": { "step": { "type": "number" }, "t0": { "type": "number" },
              "speakers": { "type": "array", "items": { "type": "string" } },
              "f0_st": { "type": "array", "items": { "type": ["number", "null"] }, "description": "Semitones relative to each speaker's median" },
              "speaker": { "type": "array", "items": { "type": ["integer", "null"] } } } },
          "default_dimensional": { "type": ["string", "null"], "description": "The emotion_models key readers show by default." },
          "emotion_models": { "type": "object", "description": "Per emotion key: the model that wrote it.",
            "additionalProperties": { "type": "object", "required": ["model", "licence_mode", "kind"],
              "properties": { "model": { "type": "string" }, "licence_mode": { "$ref": "#/$defs/licenceMode" },
                "kind": { "enum": ["dimensional", "categorical"] } } } },
          "caption_models": { "type": "object", "description": "Per caption key: the model that wrote it.",
            "additionalProperties": { "type": "object", "required": ["model", "licence_mode"],
              "properties": { "model": { "type": "string" }, "licence_mode": { "$ref": "#/$defs/licenceMode" } } } },
          "utterances": { "type": "array", "items": { "type": "object", "required": ["utt"],
            "properties": { "utt": { "$ref": "#/$defs/id/utt" }, "speaker": { "type": ["string", "null"] },
              "measures": { "type": "object" },
              "words": { "type": "array" },
              "emotion": { "type": "object", "description": "Per emotion_models key: {arousal, valence, dominance} or categorical scores." },
              "captions": { "type": "object", "description": "Per caption_models key: {description, tags, emphasized_words}." } } } }
        }
      },

      "waveform": {
        "allOf": [{ "$ref": "#/$defs/layerBase" }, { "properties": { "layer": { "const": "waveform" } } }],
        "required": ["hz", "peaks"],
        "properties": {
          "hz": { "type": "number", "exclusiveMinimum": 0, "description": "Bins per second." },
          "peaks": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 100 },
            "description": "Peak absolute amplitude per bin, 0-100 relative to the loudest bin." }
        }
      }
    }
  }
}
